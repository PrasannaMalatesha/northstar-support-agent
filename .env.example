# Copy to apps/web/.env.local and to the API environment.
# FASTAPI_URL is read only by the Next.js server. Do not prefix it with NEXT_PUBLIC_.

AUTH_SECRET=replace-with-a-long-random-string
FASTAPI_URL=http://127.0.0.1:8000
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://northstar:northstar@localhost:5433/northstar
TOKEN_SECRET=replace-with-a-long-random-string
# Judge only. A different model from the agent. Leave the value empty in git.
OPENROUTER_API_KEY=
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Agent only. A different model from the judge. Leave the value empty in git.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3-flash-preview
# Tracing. Leave the key empty in git. Project name is per environment.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=northstar-local
PINECONE_API_KEY=
PINECONE_INDEX=northstar-handbook
PINECONE_NAMESPACE=handbook-dev
