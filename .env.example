# Copy to apps/web/.env.local and to the API environment.
# FASTAPI_URL is read only by the Next.js server. Do not prefix it with NEXT_PUBLIC_.

AUTH_SECRET=replace-with-a-long-random-string
FASTAPI_URL=http://127.0.0.1:8000
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://northstar:northstar@localhost:5433/northstar
TOKEN_SECRET=replace-with-a-long-random-string
# Judge only. A different model from the agent. Leave the value empty in git.
OPENROUTER_API_KEY=
JUDGE_MODEL=deepseek/deepseek-v4.1-flash
# Agent only. A different model from the judge. Leave the value empty in git.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3-flash-preview
# Optional second agent model, used only when AGENT_MODEL fails. Empty turns the fallback off.
AGENT_FALLBACK_MODEL=
# Tracing. Leave the key empty in git. Project name is per environment.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=northstar-local
PINECONE_API_KEY=
PINECONE_INDEX=northstar-handbook
# local and dev may only use handbook-dev. uat uses handbook-uat. prod uses handbook-prod.
NORTHSTAR_ENV=local
PINECONE_NAMESPACE=handbook-dev

# Google single sign-on for staff (issue #78). Leave empty to keep the password login.
# Redirect URI to register in Google Cloud: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Live chat with a specialist (update phase). Off by default; turn it on locally and in dev first.
LIVE_CHAT_ENABLED=false
LIVE_CHATS_PER_SPECIALIST=2
# Per-turn deadline in seconds; optional model steps are skipped when time is short.
TURN_DEADLINE_SECONDS=45

# Minutes a staff API token lasts. The console renews it with the refresh token shortly before it ends.
ACCESS_TOKEN_MINUTES=15
